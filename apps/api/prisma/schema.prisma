generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalType {
  HEALTHY_LIFESTYLE
  IMPROVE_FITNESS
  BUILD_MUSCLE
  IMPROVE_ENDURANCE
  REDUCE_WEIGHT
}

enum GoalImpactMode {
  NUTRITION_ONLY
  NUTRITION_AND_TRAINING
}

enum PrimaryGoal {
  WEIGHT_LOSS
  WEIGHT_MAINTENANCE
  WEIGHT_GAIN
  HEALTHY_EATING
}

enum DietType {
  NONE
  OMNIVORE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  KETO
  LOW_CARB
  MEDITERRANEAN
  HALAL
  KOSHER
}

enum ActivityLevel {
  LOW
  LIGHT
  MODERATE
  HIGH
  ATHLETE
}

enum SportType {
  RUNNING
  CYCLING
  GYM
  STRENGTH
  HIIT
  YOGA
  SWIMMING
  WALKING
  TEAM_SPORT
  OTHER
}

enum IntensityLevel {
  LOW
  MODERATE
  HIGH
}

enum PlanStatus {
  READY
  FALLBACK
}

enum PlanCheckpointProposalStatus {
  PENDING
  APPLIED
  DISMISSED
  EXPIRED
}

enum DailyReadinessLevel {
  RECOVER
  MAINTAIN
  PUSH
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum PreWorkoutReadinessStatus {
  GOOD
  TIRED
  SORE
  PAIN_OR_LIMITATION
  SKIPPED
}

enum PostWorkoutFeeling {
  GOOD
  TOO_EASY
  TOO_HARD
  PAIN_DURING_WORKOUT
  SKIPPED
}

enum PlanFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum PlanFeedbackTag {
  TOO_MUCH_FOOD
  TOO_LITTLE_FOOD
  TRAINING_TOO_HARD
  TRAINING_TOO_EASY
  FELT_GOOD
  LOW_ENERGY
  RECOVERY_NEEDED
}

enum AiOperationFeature {
  DAILY_PLAN
}

enum AiOperationProvider {
  MOCK
  OPENAI
}

enum AiOperationStatus {
  SUCCESS
  FALLBACK
  ERROR
}

enum AiRequestAgent {
  DAILY_PLAN
  PLAN_CHECKPOINT
  NUTRITION
  SAFETY
  TRAINING_LOAD
}

enum AiRequestOperation {
  DAILY_PLAN_GENERATION
  PLAN_CHECKPOINT
  NUTRITION_GENERATION
  MENU_REGENERATION
  MEAL_REGENERATION
  SAFETY_REVIEW
  TRAINING_LOAD
}

enum AiModelRoute {
  LUNA
  TERRA
  SOL
}

enum SubscriptionPlan {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE_PERIOD
  CANCELED
  EXPIRED
  PAST_DUE
}

enum SubscriptionProvider {
  APP_STORE
  GOOGLE_PLAY
  DEV
}

enum SubscriptionEnvironment {
  SANDBOX
  PRODUCTION
}

enum BillingEventProvider {
  REVENUECAT
}

enum BillingEventProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PlanQualityMode {
  BASIC
  PERSONALIZED
  ADAPTIVE
}

enum PregnancyStatus {
  NOT_PREGNANT
  PREGNANT
  POSTPARTUM
  BREASTFEEDING
  PREFER_NOT_TO_SAY
  UNKNOWN
}

enum UsagePeriodType {
  DAILY
  MONTHLY
}

enum UsageFeature {
  DAILY_PLAN_GENERATION
  DAILY_PLAN_REFRESH
  AI_DAILY_PLAN_GENERATION
  AI_PLAN_CHECKPOINT_PROPOSAL
  AI_SAFETY_AGENT_REVIEW
  MEAL_REGENERATION
  MENU_REGENERATION
  AI_TRAINING_LOAD_AGENT
  FUTURE_AI_COACH_MESSAGE
}

enum ProgressiveProfilePromptKey {
  PREFERRED_FOODS
  EXCLUDED_FOODS
  DIET_TYPE
  MEALS_PER_DAY
  TARGET_MUSCLE_GROUPS
  TRAINING_OUTCOME
  EQUIPMENT
  TRAINING_LEVEL
  LIMITATIONS_OR_PAIN_AREAS
  COOKING_TIME
  MEAL_PREP
  MEAL_TIMING
}

enum ProgressiveProfilePromptStatus {
  PENDING
  ANSWERED
  SKIPPED
}

enum DailyCheckInType {
  MEAL
  TRAINING
  EVENING_REFLECTION
}

enum FoodMealProgressStatus {
  PLANNED
  EATEN
  PARTIALLY_EATEN
  SKIPPED
}

enum FoodLogMealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

enum TrainingOutcome {
  STRENGTH
  MUSCLE_GROWTH
  ENDURANCE
  MOBILITY
  GENERAL_FITNESS
}

enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TargetMuscleGroup {
  CHEST
  TRAPS
  LATS
  LOWER_BACK
  ABS
  OBLIQUES
  BICEPS
  TRICEPS
  FOREARMS
  QUADRICEPS
  HAMSTRINGS
  ADDUCTORS
  ABDUCTORS
  CALVES
  BACK
  LEGS
  GLUTES
  CORE
  SHOULDERS
  ARMS
  FULL_BODY
}

enum TrainingEquipment {
  GYM
  HOME
  DUMBBELLS
  BODYWEIGHT
  MACHINES
}

enum TrainingEnvironment {
  HOME
  GYM
  OUTDOOR
}

enum TrainingScheduleDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TrainingScheduleOverrideMode {
  USE_DEFAULT
  CUSTOM
}

enum DailyTrainingOverrideType {
  TRAINING_DAY
  REST_DAY
}

enum DailyTrainingOverrideSource {
  USER_SELECTED_TRAIN_TODAY
  USER_SELECTED_REST_TODAY
  USER_MOVED_WORKOUT
  MANUAL
}

enum HealthProvider {
  APPLE_HEALTH
  HEALTH_CONNECT
  WHOOP
  GARMIN
  MANUAL
  MOCK
}

enum WeightDataSource {
  MANUAL
  APPLE_HEALTH
  HEALTH_CONNECT
  WHOOP
  GARMIN
}

enum HealthConnectionStatus {
  CONNECTED
  DISCONNECTED
  NOT_CONNECTED
  NEEDS_REAUTH
  PERMISSION_DENIED
  ERROR
  DISABLED
}

enum PreferredLocale {
  EN_US @map("en-US")
  RU_RU @map("ru-RU")
  FR_FR @map("fr-FR")
  ZH_CN @map("zh-CN")
}

enum FoodCatalogSource {
  CURATED
  USDA_FDC
}

enum FoodCatalogCategory {
  PROTEIN
  GRAIN
  LEGUME
  VEGETABLE
  FRUIT
  DAIRY_OR_ALTERNATIVE
  FAT
  OTHER
}

// Catalog metadata used to select genuinely practical meal variants.
// It never changes nutrition values or restriction filtering.
enum FoodPreparationLevel {
  READY_TO_EAT
  QUICK_ASSEMBLY
  COOK_REQUIRED
}

enum FoodRestrictionTag {
  DAIRY
  EGG
  FISH
  SHELLFISH
  PEANUT
  TREE_NUT
  SOY
  SESAME
  WHEAT
  GLUTEN
}

enum MeasurementSystem {
  METRIC
  IMPERIAL
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum ExerciseCategory {
  STRENGTH
  MOBILITY
  CARDIO
  RECOVERY
}

enum ExerciseEquipment {
  NONE
  BODYWEIGHT
  DUMBBELLS
  BARBELL
  KETTLEBELL
  RESISTANCE_BANDS
  MACHINES
  BENCH
  PULL_UP_BAR
  CABLE_MACHINE
  CARDIO_MACHINE
}

enum MovementPattern {
  SQUAT
  HINGE
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  LUNGE
  CARRY
  ROTATION
  ANTI_ROTATION
  CORE_FLEXION
  CORE_STABILITY
  ISOLATION
  MOBILITY
  CARDIO
  RECOVERY
}

enum ExerciseContraindicationTag {
  WRIST_LOAD
  ELBOW_LOAD
  SHOULDER_LOAD
  KNEE_LOAD
  LOWER_BACK_LOAD
  OVERHEAD_POSITION
  BALANCE_REQUIRED
  HIGH_IMPACT
  PRONE_POSITION
  SUPINE_POSITION
  PREGNANCY_REVIEW
  POSTPARTUM_REVIEW
}

enum ExerciseMediaType {
  PRIMARY
  TECHNIQUE
  ANATOMY
  ALTERNATE
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  emailVerifiedAt    DateTime?
  authVersion        Int       @default(0)
  firstName          String?
  lastName           String?
  timezone           String    @default("UTC")
  locale             String    @default("en")
  isMinor            Boolean   @default(false)
  safeMode           Boolean   @default(false)
  noTrainingPlanned  Boolean   @default(false)
  privacyConsentedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile                   Profile?
  goal                      Goal?
  nutritionPref             NutritionPreference?
  schedules                 TrainingScheduleItem[]
  dailyPlans                DailyPlan[]
  planFeedback              DailyPlanFeedback[]
  workoutSessions           WorkoutSession[]
  foodDayLogs               FoodDayLog[]
  checkpointProposals       DailyPlanCheckpointProposal[]
  aiOperationLogs           AiOperationLog[]
  aiRequestLogs             AiRequestLog[]
  subscriptions             Subscription[]
  billingEvents             BillingEvent[]
  usageLedger               UsageLedger[]
  progressiveProfilePrompts UserProgressiveProfilePrompt[]
  dailyPlanCheckIns         DailyPlanCheckIn[]
  trainingPreference        TrainingPreference?
  weeklyTrainingSchedule    TrainingSchedule?
  dailyTrainingOverrides    DailyTrainingOverride[]
  healthConnections         HealthConnection[]
  healthDailySummaries      HealthDailySummary[]
  wearableDailySnapshots    WearableDailySnapshot[]
  whoopOAuthCredential      WhoopOAuthCredential?
  whoopOAuthStates          WhoopOAuthState[]
  availableFoods            UserAvailableFood[]
  weightLogs                WeightLog[]
  settings                  UserSettings?
  authCodes                 AuthCode[]

  @@index([createdAt])
}

model AuthCode {
  id             String          @id @default(cuid())
  userId         String
  purpose        AuthCodePurpose
  codeHash       String
  expiresAt      DateTime
  consumedAt     DateTime?
  failedAttempts Int             @default(0)
  createdAt      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model WeightLog {
  id         String           @id @default(cuid())
  userId     String
  localDate  String
  measuredAt DateTime
  weightKg   Decimal          @db.Decimal(6, 2)
  source     WeightDataSource
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate, source])
  @@index([userId, measuredAt])
  @@index([userId, localDate])
  @@index([userId, source, localDate])
}

model UserSettings {
  id                String            @id @default(cuid())
  userId            String            @unique
  preferredLocale   PreferredLocale   @default(EN_US)
  measurementSystem MeasurementSystem @default(METRIC)
  themePreference   ThemePreference   @default(SYSTEM)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([preferredLocale])
  @@index([measurementSystem])
}

model Profile {
  id              String          @id @default(cuid())
  userId          String          @unique
  gender          String?
  pregnancyStatus PregnancyStatus @default(UNKNOWN)
  dateOfBirth     DateTime
  heightCm        Float
  weightKg        Float
  activityLevel   ActivityLevel
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dateOfBirth])
  @@index([pregnancyStatus])
}

model Goal {
  id                 String          @id @default(cuid())
  userId             String          @unique
  goalType           GoalType
  primaryGoal        PrimaryGoal?
  targetWeightKg     Float?
  targetTimelineDays Int?
  impactMode         GoalImpactMode?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NutritionPreference {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  dietType                  DietType @default(NONE)
  mealsPerDay               Int      @default(3)
  noKnownAllergiesConfirmed Boolean  @default(false)
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergies      Allergy[]
  excludedFoods  ExcludedFood[]
  dislikedFoods  DislikedFood[]
  preferredFoods PreferredFood[]
}

model Allergy {
  id                    String @id @default(cuid())
  nutritionPreferenceId String
  name                  String

  nutritionPreference NutritionPreference @relation(fields: [nutritionPreferenceId], references: [id], onDelete: Cascade)

  @@index([nutritionPreferenceId])
}

model ExcludedFood {
  id                    String @id @default(cuid())
  nutritionPreferenceId String
  name                  String

  nutritionPreference NutritionPreference @relation(fields: [nutritionPreferenceId], references: [id], onDelete: Cascade)

  @@index([nutritionPreferenceId])
}

model DislikedFood {
  id                    String @id @default(cuid())
  nutritionPreferenceId String
  name                  String

  nutritionPreference NutritionPreference @relation(fields: [nutritionPreferenceId], references: [id], onDelete: Cascade)

  @@index([nutritionPreferenceId])
}

model PreferredFood {
  id                    String @id @default(cuid())
  nutritionPreferenceId String
  name                  String

  nutritionPreference NutritionPreference @relation(fields: [nutritionPreferenceId], references: [id], onDelete: Cascade)

  @@index([nutritionPreferenceId])
}

model TrainingScheduleItem {
  id              String         @id @default(cuid())
  userId          String
  dayOfWeek       Int
  localTime       String
  sportType       SportType
  durationMinutes Int
  intensity       IntensityLevel
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model TrainingSchedule {
  id           String                    @id @default(cuid())
  userId       String                    @unique
  isActive     Boolean                   @default(false)
  weekStartsOn TrainingScheduleDayOfWeek @default(MONDAY)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  days TrainingScheduleDay[]

  @@index([userId, isActive])
}

model TrainingScheduleDay {
  id                 String                       @id @default(cuid())
  trainingScheduleId String
  dayOfWeek          TrainingScheduleDayOfWeek
  isTrainingDay      Boolean                      @default(false)
  targetMusclesMode  TrainingScheduleOverrideMode @default(USE_DEFAULT)
  targetMuscles      TargetMuscleGroup[]          @default([])
  environmentMode    TrainingScheduleOverrideMode @default(USE_DEFAULT)
  environment        TrainingEnvironment?
  equipmentMode      TrainingScheduleOverrideMode @default(USE_DEFAULT)
  availableEquipment ExerciseEquipment[]          @default([])
  durationMode       TrainingScheduleOverrideMode @default(USE_DEFAULT)
  durationMinutes    Int?
  protocolMode       TrainingScheduleOverrideMode @default(USE_DEFAULT)
  protocolPreference String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  trainingSchedule TrainingSchedule @relation(fields: [trainingScheduleId], references: [id], onDelete: Cascade)

  @@unique([trainingScheduleId, dayOfWeek])
  @@index([dayOfWeek])
}

model DailyTrainingOverride {
  id                 String                      @id @default(cuid())
  userId             String
  localDate          String
  timezone           String
  overrideType       DailyTrainingOverrideType
  targetMuscles      TargetMuscleGroup[]         @default([])
  environment        TrainingEnvironment?
  availableEquipment ExerciseEquipment[]         @default([])
  durationMinutes    Int?
  protocolPreference String?
  source             DailyTrainingOverrideSource @default(MANUAL)
  movedFromLocalDate String?
  movedToLocalDate   String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId, localDate])
  @@index([userId, overrideType])
  @@index([source])
}

model DailyPlan {
  id             String              @id @default(cuid())
  userId         String
  planLocalDate  String
  planTimezone   String
  status         PlanStatus
  readinessLevel DailyReadinessLevel
  planJson       Json
  createdByAi    Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback            DailyPlanFeedback[]
  checkIns            DailyPlanCheckIn[]
  workoutSessions     WorkoutSession[]
  foodDayLogs         FoodDayLog[]
  checkpointProposals DailyPlanCheckpointProposal[]

  @@unique([userId, planLocalDate, planTimezone])
  @@index([userId, createdAt])
}

model DailyPlanCheckpointProposal {
  id                  String                       @id @default(cuid())
  userId              String
  dailyPlanId         String
  sourcePlanUpdatedAt DateTime
  trigger             String
  severity            String
  reasonCodes         String[]
  affectedSections    String[]
  evaluationJson      Json
  proposedPlanJson    Json
  summaryTitle        String
  summaryMessage      String
  status              PlanCheckpointProposalStatus @default(PENDING)
  resolvedAt          DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([dailyPlanId, status, createdAt])
  @@index([sourcePlanUpdatedAt])
}

model FoodDayLog {
  id                 String   @id @default(cuid())
  userId             String
  dailyPlanId        String
  localDate          String
  plannedMealCount   Int      @default(0)
  completedMealCount Int      @default(0)
  partialMealCount   Int      @default(0)
  skippedMealCount   Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlan    DailyPlan          @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  mealProgress FoodMealProgress[]

  @@unique([userId, dailyPlanId])
  @@index([userId, localDate])
  @@index([dailyPlanId])
}

model FoodMealProgress {
  id                String                 @id @default(cuid())
  foodDayLogId      String
  mealId            String
  mealOrder         Int
  mealType          FoodLogMealType
  mealTitleSnapshot String
  status            FoodMealProgressStatus @default(PLANNED)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  foodDayLog FoodDayLog @relation(fields: [foodDayLogId], references: [id], onDelete: Cascade)

  @@unique([foodDayLogId, mealId])
  @@index([foodDayLogId, mealOrder])
  @@index([status])
}

model WorkoutSession {
  id                                 String                     @id @default(cuid())
  userId                             String
  dailyPlanId                        String
  status                             WorkoutSessionStatus       @default(IN_PROGRESS)
  preWorkoutReadinessStatus          PreWorkoutReadinessStatus?
  preWorkoutPainAreas                String[]                   @default([])
  preWorkoutNote                     String?
  preWorkoutConflictDetected         Boolean                    @default(false)
  preWorkoutConflictMuscleGroups     String[]                   @default([])
  preWorkoutConflictingExerciseKeys  String[]                   @default([])
  preWorkoutAcknowledgedPainConflict Boolean                    @default(false)
  postWorkoutFeeling                 PostWorkoutFeeling?
  postWorkoutPainAreas               String[]                   @default([])
  postWorkoutNote                    String?
  startedAt                          DateTime                   @default(now())
  completedAt                        DateTime?
  plannedExerciseCount               Int                        @default(0)
  completedExerciseCount             Int                        @default(0)
  plannedSetCount                    Int                        @default(0)
  completedSetCount                  Int                        @default(0)
  createdAt                          DateTime                   @default(now())
  updatedAt                          DateTime                   @updatedAt

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlan        DailyPlan                 @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  exerciseProgress WorkoutExerciseProgress[]

  @@unique([userId, dailyPlanId])
  @@index([userId, status, updatedAt])
  @@index([dailyPlanId])
}

model WorkoutExerciseProgress {
  id                     String   @id @default(cuid())
  workoutSessionId       String
  planExerciseKey        String
  planExerciseOrder      Int
  exerciseId             String?
  exerciseSlug           String?
  exerciseNameSnapshot   String
  plannedSets            Int?
  plannedReps            String?
  plannedDurationSeconds Int?
  plannedRestSeconds     Int?
  completedSetIndexes    Int[]    @default([])
  isExerciseCompleted    Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@unique([workoutSessionId, planExerciseKey])
  @@index([workoutSessionId, planExerciseOrder])
}

model DailyPlanFeedback {
  id          String              @id @default(cuid())
  userId      String
  dailyPlanId String
  rating      PlanFeedbackRating?
  tags        PlanFeedbackTag[]
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyPlanId])
  @@index([userId, createdAt])
  @@index([dailyPlanId])
}

model AiOperationLog {
  id                  String              @id @default(cuid())
  userId              String
  feature             AiOperationFeature
  provider            AiOperationProvider
  route               AiModelRoute?
  planQualityMode     PlanQualityMode?
  model               String?
  status              AiOperationStatus
  finalPlanStatus     PlanStatus?
  latencyMs           Int
  retryCount          Int                 @default(0)
  safetyAgentEnabled  Boolean             @default(false)
  safetyAgentProvider String?
  safetyAgentApproved Boolean?
  fallbackReason      String?
  errorReason         String?
  createdAt           DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@index([route, createdAt])
  @@index([planQualityMode, createdAt])
  @@index([finalPlanStatus, createdAt])
}

model AiRequestLog {
  id                    String              @id @default(cuid())
  userId                String
  agent                 AiRequestAgent
  operation             AiRequestOperation
  route                 AiModelRoute
  provider              AiOperationProvider
  model                 String
  status                AiOperationStatus
  latencyMs             Int
  retryAttempt          Boolean             @default(false)
  inputTokens           Int                 @default(0)
  outputTokens          Int                 @default(0)
  totalTokens           Int                 @default(0)
  estimatedCostMicrousd Int?
  errorReason           String?
  createdAt             DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([agent, createdAt])
  @@index([operation, createdAt])
  @@index([route, createdAt])
  @@index([status, createdAt])
}

model Subscription {
  id                     String                  @id @default(cuid())
  userId                 String
  plan                   SubscriptionPlan
  status                 SubscriptionStatus
  provider               SubscriptionProvider
  environment            SubscriptionEnvironment
  providerCustomerId     String?
  providerSubscriptionId String?
  providerTransactionId  String?
  originalTransactionId  String?
  providerProductId      String?
  startsAt               DateTime
  expiresAt              DateTime?
  canceledAt             DateTime?
  graceEndsAt            DateTime?
  willRenew              Boolean?
  lastVerifiedAt         DateTime?
  lastProviderEventAt    DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingEvents BillingEvent[]

  @@index([userId, startsAt])
  @@index([userId, status])
  @@unique([provider, environment, providerSubscriptionId])
  @@index([originalTransactionId])
}

model BillingEvent {
  id                 String                       @id @default(cuid())
  provider           BillingEventProvider
  providerEventId    String
  eventType          String
  status             BillingEventProcessingStatus @default(RECEIVED)
  environment        SubscriptionEnvironment?
  store              SubscriptionProvider?
  userId             String?
  subscriptionId     String?
  providerCustomerId String?
  providerProductId  String?
  occurredAt         DateTime?
  receivedAt         DateTime                     @default(now())
  processedAt        DateTime?
  safeErrorCode      String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([provider, status, receivedAt])
  @@index([userId, receivedAt])
  @@index([subscriptionId, receivedAt])
  @@index([providerCustomerId, receivedAt])
}

model UsageLedger {
  id          String          @id @default(cuid())
  userId      String
  feature     UsageFeature
  periodType  UsagePeriodType
  periodStart DateTime
  count       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, periodType, periodStart])
  @@index([userId, periodStart])
  @@index([feature, periodStart])
  @@index([userId, feature, periodType, periodStart])
}

model UserProgressiveProfilePrompt {
  id           String                         @id @default(cuid())
  userId       String
  promptKey    ProgressiveProfilePromptKey
  status       ProgressiveProfilePromptStatus @default(PENDING)
  answerJson   Json?
  answeredAt   DateTime?
  skippedAt    DateTime?
  skippedUntil DateTime?
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptKey])
  @@index([userId, status])
  @@index([userId, skippedUntil])
}

model DailyPlanCheckIn {
  id          String           @id @default(cuid())
  userId      String
  dailyPlanId String
  type        DailyCheckInType
  subjectKey  String           @default("default")
  payload     Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyPlanId, type, subjectKey])
  @@index([userId, createdAt])
  @@index([dailyPlanId, type])
  @@index([userId, dailyPlanId])
}

model TrainingPreference {
  id                     String              @id @default(cuid())
  userId                 String              @unique
  targetMuscleGroups     TargetMuscleGroup[] @default([])
  trainingOutcome        TrainingOutcome?
  equipment              TrainingEquipment[] @default([])
  trainingLevel          TrainingLevel?
  limitationsOrPainAreas String[]            @default([])
  preferredTrainingDays  Int[]               @default([])
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthConnection {
  id                 String                 @id @default(cuid())
  userId             String
  provider           HealthProvider
  status             HealthConnectionStatus @default(DISCONNECTED)
  consentedAt        DateTime?
  disconnectedAt     DateTime?
  lastSyncAt         DateTime?
  permissionsGranted Json?
  errorReason        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, status])
  @@index([provider, status])
}

model WhoopOAuthCredential {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  accessTokenExpiresAt   DateTime?
  scopes                 String[]  @default([])
  externalUserId         String?
  encryptionVersion      Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accessTokenExpiresAt])
}

model WhoopOAuthState {
  id          String    @id @default(cuid())
  userId      String
  stateHash   String    @unique
  redirectUri String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model HealthDailySummary {
  id               String         @id @default(cuid())
  userId           String
  localDate        String
  timezone         String
  sourceProvider   HealthProvider
  steps            Int?
  sleepMinutes     Int?
  activeEnergyKcal Int?
  workoutCount     Int?
  workoutMinutes   Int?
  averageHeartRate Int?
  restingHeartRate Int?
  weightKg         Decimal?       @db.Decimal(6, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate, sourceProvider])
  @@index([userId, localDate])
  @@index([sourceProvider, localDate])
}

model WearableDailySnapshot {
  id                  String         @id @default(cuid())
  userId              String
  source              HealthProvider
  localDate           String
  timezone            String
  steps               Int?
  activeCaloriesKcal  Int?
  workoutMinutes      Int?
  sleepMinutes        Int?
  sleepQualityScore   Int?
  recoveryScore       Int?
  strainScore         Float?
  restingHeartRateBpm Int?
  hrvMs               Int?
  respiratoryRate     Float?
  capturedAt          DateTime
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, localDate])
  @@index([userId, localDate])
  @@index([source, localDate])
  @@index([userId, capturedAt])
}

model Exercise {
  id                   String                        @id @default(cuid())
  slug                 String                        @unique
  category             ExerciseCategory
  movementPattern      MovementPattern
  equipment            ExerciseEquipment[]           @default([])
  targetMuscles        TargetMuscleGroup[]           @default([])
  secondaryMuscles     TargetMuscleGroup[]           @default([])
  trainingLevels       TrainingLevel[]               @default([])
  contraindicationTags ExerciseContraindicationTag[] @default([])
  isActive             Boolean                       @default(true)
  sortOrder            Int                           @default(0)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  translations         ExerciseTranslation[]
  media                ExerciseMedia[]

  @@index([isActive, sortOrder, slug])
  @@index([category, isActive])
  @@index([movementPattern, isActive])
}

model ExerciseTranslation {
  id           String          @id @default(cuid())
  exerciseId   String
  locale       PreferredLocale
  name         String
  description  String?
  instructions String[]        @default([])
  coachingCues String[]        @default([])
  safetyNotes  String[]        @default([])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  exercise     Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, locale])
  @@index([locale, name])
}

model ExerciseMedia {
  id           String                     @id @default(cuid())
  exerciseId   String
  seedKey      String?                    @unique
  type         ExerciseMediaType
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  sortOrder    Int                        @default(0)
  isPrimary    Boolean                    @default(false)
  isActive     Boolean                    @default(true)
  source       String?
  license      String?
  attribution  String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  exercise     Exercise                   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  translations ExerciseMediaTranslation[]

  @@index([exerciseId, isActive, sortOrder])
  @@index([exerciseId, isPrimary, isActive])
}

model ExerciseMediaTranslation {
  id              String          @id @default(cuid())
  exerciseMediaId String
  locale          PreferredLocale
  altText         String
  caption         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  exerciseMedia   ExerciseMedia   @relation(fields: [exerciseMediaId], references: [id], onDelete: Cascade)

  @@unique([exerciseMediaId, locale])
  @@index([locale])
}

model FoodCatalogItem {
  id                String                   @id @default(cuid())
  slug              String                   @unique
  source            FoodCatalogSource        @default(CURATED)
  sourceFoodId      String?
  category          FoodCatalogCategory
  preparationLevel  FoodPreparationLevel     @default(COOK_REQUIRED)
  caloriesPer100g   Int
  proteinPer100g    Decimal                  @db.Decimal(7, 2)
  carbsPer100g      Decimal                  @db.Decimal(7, 2)
  fatPer100g        Decimal                  @db.Decimal(7, 2)
  fiberPer100g      Decimal?                 @db.Decimal(7, 2)
  dietTypes         DietType[]               @default([])
  restrictionTags   FoodRestrictionTag[]     @default([])
  isActive          Boolean                  @default(true)
  sortOrder         Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  translations      FoodCatalogTranslation[]
  availableForUsers UserAvailableFood[]

  @@unique([source, sourceFoodId])
  @@index([isActive, sortOrder, slug])
  @@index([category, isActive])
}

model UserAvailableFood {
  id                String   @id @default(cuid())
  userId            String
  foodCatalogItemId String
  localDate         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodCatalogItem FoodCatalogItem @relation(fields: [foodCatalogItemId], references: [id], onDelete: Cascade)

  @@unique([userId, foodCatalogItemId, localDate])
  @@index([userId, localDate])
  @@index([foodCatalogItemId])
}

model FoodCatalogTranslation {
  id                String          @id @default(cuid())
  foodCatalogItemId String
  locale            PreferredLocale
  name              String
  aliases           String[]        @default([])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  foodCatalogItem   FoodCatalogItem @relation(fields: [foodCatalogItemId], references: [id], onDelete: Cascade)

  @@unique([foodCatalogItemId, locale])
  @@index([locale, name])
}
