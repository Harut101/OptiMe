NODE_ENV=development
PORT=3000
API_PREFIX=v1
# Local development may use the API static route. Production requires a public
# HTTPS media origin such as https://media.optime.app.
EXERCISE_MEDIA_PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated browser origins. Production must use an explicit allowlist.
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Set to the number of trusted reverse proxies in front of the API.
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://optime:optime@localhost:5432/optime?schema=public
TEST_DATABASE_URL=postgresql://optime:optime@localhost:5432/optime_test?schema=public

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Development accepts codes without external email. Production requires Resend.
EMAIL_PROVIDER=development
AUTH_DEV_CODE=123456
AUTH_CODE_SECRET=replace-with-a-separate-long-random-secret
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REQUEST_TIMEOUT_MS=10000
SUPPORT_EMAIL=
EMAIL_REPLY_TO=
# Public auth endpoint protection. Keep enabled in production.
AUTH_RATE_LIMIT_ENABLED=true

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_DAILY_PLAN_MODEL_FREE=
OPENAI_DAILY_PLAN_MODEL_PLUS=
OPENAI_DAILY_PLAN_MODEL_PRO=
OPENAI_DAILY_PLAN_FREE_INPUT_COST_PER_1M_USD=
OPENAI_DAILY_PLAN_FREE_OUTPUT_COST_PER_1M_USD=
OPENAI_DAILY_PLAN_PLUS_INPUT_COST_PER_1M_USD=
OPENAI_DAILY_PLAN_PLUS_OUTPUT_COST_PER_1M_USD=
OPENAI_DAILY_PLAN_PRO_INPUT_COST_PER_1M_USD=
OPENAI_DAILY_PLAN_PRO_OUTPUT_COST_PER_1M_USD=
OPENAI_REQUEST_TIMEOUT_MS=45000
# Per-operation limits fall back to OPENAI_MAX_OUTPUT_TOKENS when omitted.
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_DAILY_PLAN_MAX_OUTPUT_TOKENS=4000
OPENAI_NUTRITION_MAX_OUTPUT_TOKENS=4000
OPENAI_CHECKPOINT_MAX_OUTPUT_TOKENS=4000
OPENAI_SAFETY_MAX_OUTPUT_TOKENS=1200
OPENAI_TRAINING_LOAD_MAX_OUTPUT_TOKENS=1200
AI_BENCHMARK_MODE=false
AI_BENCHMARK_REAL_CALLS_ENABLED=false
AI_BENCHMARK_DATABASE_URL=
AI_BENCHMARK_MAX_COST_USD=10
AI_BENCHMARK_MAX_REQUESTS=300
AI_BENCHMARK_MAX_INPUT_TOKENS_PER_REQUEST=100000
AI_BENCHMARK_COST_SAFETY_MULTIPLIER=1.5
AI_BENCHMARK_PROFILES_PER_TIER=2
AI_BENCHMARK_FLOW_LABEL=nutrition-agent-authoritative-v1
AI_BENCHMARK_REPORT_PATH=
AI_COST_CEILING_ENFORCEMENT_ENABLED=false
# Launch candidates based on the approved pricing model and bounded benchmark.
# Revalidate with representative rolling telemetry before enabling billing.
AI_MONTHLY_COST_CEILING_FREE_USD=1.50
AI_MONTHLY_COST_CEILING_PLUS_USD=4.00
AI_MONTHLY_COST_CEILING_PRO_USD=8.00
AI_COST_REPORT_DAYS=30
AI_COST_MIN_TIER_SAMPLES=30
AI_COST_MIN_PRICED_COVERAGE_PERCENT=95
AI_STOREFRONT_COMMISSION_PERCENT=20
AI_MEDIAN_COST_MAX_PERCENT_NET=15
AI_P95_COST_MAX_PERCENT_NET=25
AI_PRICE_PLUS_MONTHLY_USD=19.99
AI_PRICE_PRO_MONTHLY_USD=39.99
AI_QUALITY_MIN_TIER_SAMPLES=30
AI_QUALITY_MIN_TELEMETRY_COVERAGE_PERCENT=95
AI_QUALITY_MIN_READY_RATE_PERCENT=98
AI_QUALITY_MAX_FALLBACK_RATE_PERCENT=2
AI_QUALITY_MAX_RETRY_RATE_PERCENT=25

# Billing remains disabled until the quality/economics and store sandbox gates pass.
BILLING_ENABLED=false
BILLING_PROVIDER=revenuecat
BILLING_RECONCILIATION_TIMEOUT_MS=10000
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_WEBHOOK_SIGNING_SECRET=

# Mobile public SDK configuration. These are RevenueCat platform public keys,
# never the backend secret API key. Keep disabled until store sandbox QA passes.
EXPO_PUBLIC_BILLING_ENABLED=false
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

SAFETY_AGENT_ENABLED=false
SAFETY_AGENT_PROVIDER=mock

# WHOOP remains disabled unless every required server-side credential is configured.
WHOOP_INTEGRATION_ENABLED=false
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
# Base64-encoded 32-byte key used only by the backend to encrypt provider tokens.
WHOOP_TOKEN_ENCRYPTION_KEY=
WHOOP_OAUTH_AUTH_URL=https://api.prod.whoop.com/oauth/oauth2/auth
WHOOP_OAUTH_TOKEN_URL=https://api.prod.whoop.com/oauth/oauth2/token
WHOOP_API_BASE_URL=https://api.prod.whoop.com/developer
WHOOP_OAUTH_STATE_TTL_SECONDS=600
WHOOP_REQUEST_TIMEOUT_MS=15000
